config_version=5

[application]
config/name="Scene Shadow Groups Regression"

[display]
window/size/viewport_width=640
window/size/viewport_height=400
window/size/no_focus=true
window/vsync/vsync_mode=0

[rendering]
debug/visibility_buffer/test_pattern=0
renderer/rendering_method="forward_plus"
lights_and_shadows/directional_shadow/size=512
lights_and_shadows/shadow_groups/map_size=512
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
